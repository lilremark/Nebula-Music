{
  "name": "nebula-music",
  "private": true,
  "version": "2.5.0-beta.10",
  "description": "Subsonic music player for the desktop.",
  "author": "Nebula",
  "main": "electron/dist/main.cjs",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "design-system": "vite --config design-system/vite.config.ts",
    "design-system:build": "vite build --config design-system/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "vite build",
    "build:main": "node esbuild.config.mjs",
    "test:desktop": "electron scripts/smokeDesktop.cjs",
    "test:player-ui": "electron scripts/smokePlayerUi.cjs",
    "test:audio": "electron scripts/testEqAudio.cjs",
    "build:electron": "node esbuild.config.mjs && vite build",
    "start:electron": "node esbuild.config.mjs && vite build && electron .",
    "preview": "vite preview",
    "dist:win": "node esbuild.config.mjs && vite build && electron-builder --win --publish never",
    "dist:mac": "node esbuild.config.mjs && vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "blueimp-md5": "^2.19.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "echogarden": "^3.4.0",
    "flubber": "^0.4.2",
    "framer-motion": "^13.4.6",
    "hls.js": "^1.7.3",
    "loading-dev": "^0.3.5",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "onnxruntime-node": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/blueimp-md5": "^2.18.2",
    "@types/flubber": "^0.4.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "jsdom": "^30.1.1",
    "fake-indexeddb": "^6.2.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true,
    "wtf_wikipedia@10.4.2": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true,
    "onnxruntime-node@1.21.1": true,
    "onnxruntime-node@1.30.0": true
  }
}
