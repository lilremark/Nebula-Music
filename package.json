{
  "name": "nebula-music",
  "private": true,
  "version": "3.0.1-beta.1",
  "description": "Subsonic music player for the desktop.",
  "author": "Nebula",
  "main": "electron/dist/main.cjs",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "design-system": "vite --config design-system/vite.config.ts",
    "design-system:build": "vite build --config design-system/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "vite build",
    "build:main": "node esbuild.config.mjs",
    "test:desktop": "electron scripts/smokeDesktop.cjs",
    "test:taskbar": "electron scripts/smokeTaskbar.cjs",
    "test:player-ui": "electron scripts/smokePlayerUi.cjs",
    "test:mini-player": "electron scripts/smokeMiniPlayer.cjs",
    "test:audio": "electron scripts/testEqAudio.cjs",
    "build:electron": "node esbuild.config.mjs && vite build",
    "start:electron": "node esbuild.config.mjs && vite build && electron .",
    "preview": "vite preview",
    "dist:win": "node scripts/prepareAiDjAssets.mjs --verify && node esbuild.config.mjs && vite build && electron-builder --win --publish never",
    "dist:mac": "node esbuild.config.mjs && vite build && electron-builder --mac --publish never",
    "postinstall": "node scripts/patchEchogarden.mjs",
    "dj:assets": "node scripts/prepareAiDjAssets.mjs",
    "dj:verify": "node esbuild.config.mjs && esbuild scripts/verifyAiDjRuntime.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron/dist/verifyAiDjRuntime.cjs && electron electron/dist/verifyAiDjRuntime.cjs",
    "test:dj-ui": "electron scripts/smokeDjUi.cjs",
    "test:dj-platforms": "electron scripts/smokeDjPlatforms.cjs",
    "test:docker": "electron scripts/smokeDocker.cjs",
    "demo:screenshots": "electron scripts/openDemoForScreenshots.cjs"
  },
  "dependencies": {
    "blueimp-md5": "^2.19.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "echogarden": "3.4.0",
    "flubber": "^0.4.2",
    "framer-motion": "^14.7.1",
    "hls.js": "^1.7.3",
    "loading-dev": "^0.3.6",
    "lucide-react": "^1.62.0",
    "motion": "^14.7.1",
    "onnxruntime-node": "1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/blueimp-md5": "^2.18.2",
    "@types/flubber": "^0.4.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vgpu/wgsl": "0.6.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@webgpu/types": "0.1.74",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typegpu": "0.12.9",
    "typescript": "^7.0.2",
    "unplugin-typegpu": "0.12.7",
    "vgpu": "0.6.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "vgpu": {
      "@modelcontextprotocol/server": "^2.4.0"
    },
    "onnxruntime-node": {
      "global-agent": "^4.1.6"
    },
    "app-builder-lib": {
      "@electron/get": "^5.1.0"
    },
    "@electron/osx-sign": {
      "plist": "^3.1.1"
    },
    "@electron/universal": {
      "plist": "^3.1.1"
    },
    "microsoft-cognitiveservices-speech-sdk": {
      "ws": "^8.22.0"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true,
    "wtf_wikipedia@10.4.2": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true,
    "onnxruntime-node@1.21.1": true,
    "onnxruntime-node@1.31.1": true
  }
}
